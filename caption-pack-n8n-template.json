    {
      "parameters": {
        "method": "POST",
        "url": "https://caption-pack-api.onrender.com/v1/caption-pack",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"topic\": \"{{ $json.Topic }}\",\n  \"audience\": \"{{ $json.Audience }}\",\n  \"tone\": \"{{ $json.Tone || 'warm' }}\",\n  \"platform\": \"{{ $json.Platform || 'instagram' }}\",\n  \"count\": {{ $json.Count || 5 }},\n  \"include_hashtags\": true\n}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": null,
          "name": "Caption-Pack API Key"
        }
      },
      "id": "cc89508f-5d7b-43c8-bbb9-4ebbda73ff6d",
      "name": "Call Caption-Pack API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "// Format the Caption-Pack API response into a readable block.\n// Incoming: { pack_id, topic, audience, tone, platform, source,\n//             captions: [{id, hook, body, cta, hashtags[]}],\n//             credits_used, credits_remaining }\nconst pack = $input.first().json;\n\nconst tag = (h) => '#' + String(h).replace(/^#+/, '');\nconst lines = (pack.captions || []).map((c, i) => {\n  const tags = (c.hashtags || []).map(tag).join(' ');\n  return `--- Caption ${i + 1} ---\\n${c.hook}\\n\\n${c.body}\\n\\n${c.cta}\\n\\n${tags}`;\n});\n\nreturn [{\n  json: {\n    pack_id: pack.pack_id,\n    topic: pack.topic,\n    audience: pack.audience,\n    tone: pack.tone,\n    platform: pack.platform,\n    source: pack.source,\n    caption_count: (pack.captions || []).length,\n    credits_used: pack.credits_used,\n    credits_remaining: pack.credits_remaining,\n    formatted: lines.join('\\n\\n')\n  }\n}];"
      },
      "id": "62afa454-0299-4b6e-a2ec-e07619ea66ba",
      "name": "Format Captions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        420
      ]
    },
    {
      "parameters": {
        "operation": "completion",
        "completionTitle": "Your captions are ready!",
        "completionMessage": "=Pack `{{ $json.pack_id }}` — {{ $json.caption_count }} captions for **{{ $json.topic }}** ({{ $json.audience }}, {{ $json.tone }}, {{ $json.platform }}).\n\n```\n{{ $json.formatted }}\n```\n\nCredits used: {{ $json.credits_used }} | Remaining: {{ $json.credits_remaining }}",
        "options": {}
      },
      "id": "b740f718-776c-43c3-8a90-791f253c22de",
      "name": "Show Captions",
      "type": "n8n-nodes-base.form",
